# ==============================================================================
# HESIKO LAB - UNIFI & HOME ASSISTANT SECOPS CONFIGURATION
# Copy this file to '.env' and fill in your values.
# DO NOT COMMIT '.env' TO VERSION CONTROL.
# ==============================================================================

# [REQUIRED] UniFi API Key:
# Obtain from https://account.ui.com -> Security -> API Keys (or UniFi Site Manager)
# Ensure the key has Read & Management permissions for your target sites.
UNIFI_API_KEY=your_unifi_cloud_api_key_here

# [OPTIONAL] Target Sites filter:
# Comma-separated site names or substrings to audit (e.g., "site-a,site-b" or "default").
# Leave blank or set to "all" to inspect all consoles associated with your account.
TARGET_SITES=all

# [OPTIONAL] Ignore Sites:
# Comma-separated names of consoles/sites to skip (e.g., test benches or offline labs).
IGNORE_SITES=

# [OPTIONAL] Home Assistant Integration:
# URL of your Home Assistant instance (e.g. http://homeassistant.local:8123 or https://ha.yourdomain.com)
HASS_URL=http://homeassistant.local:8123
# Long-Lived Access Token created in Home Assistant (Profile -> Security -> Long-Lived Access Tokens)
HASS_TOKEN=your_home_assistant_long_lived_token_here

# [OPTIONAL] Notifications & Alerting Webhook:
# Webhook URL for self-healing and critical network alerts (Slack, Discord, Telegram, or HA webhook)
ALERT_WEBHOOK_URL=
